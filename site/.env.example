# `neon deploy` / `neon env pull` (run in site/) write most of these into .env.local. See docs/neon.md.

# Website data: read-only role on the Neon branch (schema `site` only), pooled host
SITE_DATABASE_URL=
# Local development without a database instead: a folder written by
# `python pipeline/build_site.py --json-out site/data`
SITE_DATA_DIR=data

# Owner accounts (Neon Auth). The cookie secret is not injected by Neon: `openssl rand -base64 32`
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Owners' documents (Neon Object Storage, bucket `assets`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
